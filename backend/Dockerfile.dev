# Dev-only image for the FastAPI backend.
# Runs `uvicorn --reload`. Source code is delivered via `docker compose watch`
# (sync action), not COPYd in, so saving a .py on the host triggers an in-
# container reload within a second.

FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libxml2 libxslt1.1 \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OVERPASS_STYLER_DATA_DIR=/data \
    OVERPASS_STYLER_DEV=1

WORKDIR /app

# Install runtime + reload deps. `watchfiles` is what uvicorn --reload uses.
COPY pyproject.toml ./
RUN pip install --upgrade pip \
 && pip install \
      "fastapi>=0.115" \
      "uvicorn[standard]>=0.32" \
      "lxml>=5.3" \
      "sqlalchemy>=2.0" \
      "aiosqlite>=0.20" \
      "pydantic>=2.9" \
      "python-multipart>=0.0.12" \
      "httpx>=0.27" \
      "watchfiles>=0.24"

# Seed the app dir so the image runs even before the first watch sync.
COPY app ./app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--reload", \
     "--reload-dir", "/app/app"]
